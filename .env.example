###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=placeholder_generate_a_secure_random_32_char_string_for_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format for PostgreSQL: postgresql://db_user:db_password@db_host:db_port/db_name?serverVersion=16&charset=utf8
# For local Docker setup, 'db' usually matches the service name in your compose.yaml
DATABASE_URL="postgresql://app_user:app_password@db:5432/conversion_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=placeholder_secure_passphrase_for_jwt_tokens
###< lexik/jwt-authentication-bundle ###

###> symfony/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< symfony/cors-bundle ###